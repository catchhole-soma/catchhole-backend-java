{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTempoPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::REPLACE_WITH_TEMPO_BUCKET",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["tempo", "tempo/", "tempo/*"]
        }
      }
    },
    {
      "Sid": "ManageTempoObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:GetObjectTagging",
        "s3:PutObjectTagging"
      ],
      "Resource": "arn:aws:s3:::REPLACE_WITH_TEMPO_BUCKET/tempo/*"
    }
  ]
}
