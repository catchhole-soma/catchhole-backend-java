        "textMode": "value",
        "wideLayout": true,
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "showPercentChange": false
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "API 서버 오류율 (5xx)",
      "description": "최근 5분 전체 API 요청 중 HTTP 500~599 응답의 비율입니다. 4xx는 제외합니다. 상태 확인·Actuator 요청은 제외하고 내부 API 요청은 포함합니다. 5xx가 없으면 0%, 요청이 없으면 비율을 계산할 수 없습니다. 수집 지표가 없으면 데이터 없음으로 표시합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "catchhole-prometheus"
      },
      "pluginVersion": "13.2.2",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "noValue": "데이터 없음",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "요청 없음"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "요청 없음"
                }
              }
            }
          ],
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "catchhole-prometheus"
          },
          "editorMode": "code",
          "expr": "100 * (sum(rate(http_server_requests_seconds_count{job=\"catchhole-backend\",application=\"catchhole-backend\",environment=\"prod\",uri!~\"/actuator.*|/healthz\",status=~\"5..\"}[5m])) or (0 * sum(rate(http_server_requests_seconds_count{job=\"catchhole-backend\",application=\"catchhole-backend\",environment=\"prod\",uri!~\"/actuator.*|/healthz\"}[5m])))) / sum(rate(http_server_requests_seconds_count{job=\"catchhole-backend\",application=\"catchhole-backend\",environment=\"prod\",uri!~\"/actuator.*|/healthz\"}[5m]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "last"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "showPercentChange": false
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "API 응답 시간 p95",
      "description": "최근 5분 API 요청의 약 95%가 이 시간 이내에 응답했습니다. 전체 API 요청의 응답 시간 분포로 계산한 추정값입니다. 상태 확인·Actuator 요청은 제외하고 내부 API 요청은 포함합니다. 요청이 없으면 계산할 수 없습니다. 비동기 분석 작업의 완료 시간은 포함하지 않습니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "catchhole-prometheus"
      },
      "pluginVersion": "13.2.2",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1,
          "min": 0,
          "noValue": "데이터 없음",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "요청 없음"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "요청 없음"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "catchhole-prometheus"
          },
          "editorMode": "code",
          "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"catchhole-backend\",application=\"catchhole-backend\",environment=\"prod\",uri!~\"/actuator.*|/healthz\"}[5m])))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
