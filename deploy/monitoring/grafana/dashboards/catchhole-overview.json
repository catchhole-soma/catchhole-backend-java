    {
      "id": 2,
      "type": "stat",
      "title": "초당 API 요청 수 (RPS)",
      "description": "최근 5분 동안 처리한 API 요청 수를 초당 평균으로 표시합니다. 상태 확인(/healthz)과 Actuator 요청은 제외하며, 내부 API 요청은 포함합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "catchhole-prometheus"
      },
      "pluginVersion": "13.2.2",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:요청/초",
          "decimals": 2,
          "min": 0,
          "noValue": "데이터 없음",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "mappings": []
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "catchhole-prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"catchhole-backend\",application=\"catchhole-backend\",environment=\"prod\",uri!~\"/actuator.*|/healthz\"}[5m]))",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "last"
          ],
          "fields": ""
        },
