              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "catchhole-prometheus"
          },
          "editorMode": "code",
          "expr": "100 * process_cpu_usage{job=\"catchhole-backend\",application=\"catchhole-backend\",environment=\"prod\"}",
          "legendFormat": "JVM CPU · {{instance}}",
          "range": true,
          "instant": false,
          "refId": "A"
