# 복사 후 실제 비밀번호를 채운다. monitoring.env는 커밋하지 않는다.
GRAFANA_ADMIN_USER=catchhole-admin
GRAFANA_ADMIN_PASSWORD=

# 최초 발급은 bootstrap으로 Nginx만 실행한다. 인증서 발급 뒤 grafana.conf로 전환한다.
# 설정 파일을 바꾸면 Nginx를 --force-recreate로 재생성한다.
MONITORING_NGINX_CONFIG=./monitoring/nginx/bootstrap.conf
# 최초 인증서 등록 연락처. 실제 이메일은 monitoring.env에만 입력한다.
ACME_EMAIL=

# 시간·크기 중 먼저 도달한 제한에 따라 과거 TSDB 블록을 삭제한다.
# 5GB는 전체 디스크 사용량 상한이 아니다. WAL·head·Grafana·OS 여유 공간이 필요하다.
PROMETHEUS_RETENTION_TIME=7d
PROMETHEUS_RETENTION_SIZE=5GB
PROMETHEUS_TARGETS_FILE=./monitoring/targets/catchhole-backend.json
