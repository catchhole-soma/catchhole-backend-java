# 복사 후 실제 비밀번호를 채운다. monitoring.env는 커밋하지 않는다.
GRAFANA_ADMIN_USER=catchhole-admin
GRAFANA_ADMIN_PASSWORD=

# 최초 발급은 bootstrap으로 Nginx만 실행한다. 인증서 발급 뒤 grafana.conf로 전환한다.
# 설정 파일을 바꾸면 Nginx를 --force-recreate로 재생성한다.
MONITORING_NGINX_CONFIG=./monitoring/nginx/bootstrap.conf
# 최초 인증서 등록 연락처. 실제 이메일은 monitoring.env에만 입력한다.
ACME_EMAIL=

# 시간·크기 중 먼저 도달한 제한에 따라 과거 TSDB 블록을 삭제한다.
# 5GB는 전체 디스크 사용량 상한이 아니다. WAL·head·Grafana·OS 여유 공간이 필요하다.
PROMETHEUS_RETENTION_TIME=7d
PROMETHEUS_RETENTION_SIZE=5GB
PROMETHEUS_TARGETS_FILE=./monitoring/targets/catchhole-backend.json
PROMETHEUS_WORKER_TARGETS_DIR=./monitoring/targets/workers

# compose.tracing.prod.yml을 명시적으로 추가할 때만 사용하는 OTLP/HTTP 수신 주소.
# API·Worker SG만 TCP 4318에 허용한 뒤 모니터링 EC2의 실제 사설 IPv4로 변경한다.
# 0.0.0.0 또는 공개 IPv4를 사용하지 않는다. Tempo 3200/4318은 호스트에 열지 않는다.
TRACING_OTLP_BIND_ADDRESS=127.0.0.1
# 운영 추적 전용 S3 버킷. 계측을 활성화하기 전에 생성·IAM·접근을 확인한다.
# Compose overlay 사용 시 두 값 모두 필수이며, 기존 메트릭 Compose에는 영향이 없다.
TEMPO_S3_BUCKET=
AWS_REGION=ap-northeast-2

# compose.rds-backup.prod.yml을 명시적으로 추가할 때만 사용한다.
# AWS access key나 Discord webhook은 이 예제·저장소에 넣지 않는다.
RDS_BACKUP_DB_IDENTIFIER=
