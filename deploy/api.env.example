# Container image
BACKEND_IMAGE=ghcr.io/catchhole-soma/catchhole-backend-java:sha-replace-with-published-short-sha

# Public API domain and runtime timezone
API_DOMAIN=api.catchhole.com
APP_TIMEZONE=Asia/Seoul

# Spring Backend
BACKEND_JAVA_OPTS=-Xms256m -Xmx768m
JWT_SECRET=replace-with-at-least-32-byte-secret
INTERNAL_API_KEY=replace-with-internal-api-key-shared-with-worker
CORS_ALLOWED_ORIGINS=https://catchhole.com,https://www.catchhole.com,https://catch-hole.vercel.app
SMS_PROVIDER=solapi
SOLAPI_API_KEY=replace-with-solapi-api-key
SOLAPI_API_SECRET=replace-with-solapi-api-secret
SOLAPI_SENDER_NUMBER=replace-with-registered-sender-number
PHONE_VERIFICATION_HASH_SECRET=replace-with-at-least-32-byte-random-secret
AI_TOKEN_DEFAULT_GRANT=2000000
AI_TOKEN_CONTACT_EMAIL=aicatchhole@gmail.com
AI_TOKEN_MINIMUM_ANALYSIS_RESERVATION=6256
AI_TOKEN_MINIMUM_COMPARISON_RESERVATION=16256
CHARACTER_FACT_COMPARISON_MAX_BATCH_CANDIDATES=10
CHARACTER_FACT_COMPARISON_MAX_BATCH_INPUT_CHARACTERS=30000

# Redis runs only on the API EC2 Docker network.
REDIS_PASSWORD=replace-with-strong-redis-password

# External Amazon RDS for PostgreSQL
DATABASE_URL=jdbc:postgresql://replace-with-rds-endpoint:5432/catchhole?sslmode=require
DATABASE_USERNAME=catchhole_admin
DATABASE_PASSWORD=replace-with-strong-rds-password
DATABASE_POOL_MAXIMUM_SIZE=10
DATABASE_POOL_MINIMUM_IDLE=2

# AWS and Amazon S3
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=catchhole-dev-037077640960-ap-northeast-2-an
AWS_S3_ENDPOINT_OVERRIDE=
