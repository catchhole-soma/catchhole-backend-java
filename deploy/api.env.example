# Container image
BACKEND_IMAGE=ghcr.io/catchhole-soma/catchhole-backend-java:sha-replace-with-published-short-sha

# Public API domain and runtime timezone
API_DOMAIN=api.catchhole.com
APP_TIMEZONE=Asia/Seoul

# Spring Backend
# 모니터링 SG의 8081 접근을 구성한 뒤 API EC2의 사설 IPv4로 변경한다.
# 기본값은 서버 내부 접속만 허용한다. 0.0.0.0으로 설정하지 않는다.
API_METRICS_BIND_ADDRESS=127.0.0.1
BACKEND_JAVA_OPTS=-Xms256m -Xmx768m
# Enable only after Collector/Tempo readiness, private SG rules and API image rollout.
# The image bundles the locked Java Agent and mandatory privacy extension.
BACKEND_TRACING_ENABLED=false
BACKEND_TRACING_OTLP_ENDPOINT=
# Enabled example: http://10.0.0.10:4318/v1/traces (replace with monitoring private IPv4)
JWT_SECRET=replace-with-at-least-32-byte-secret
INTERNAL_API_KEY=replace-with-internal-api-key-shared-with-worker
CORS_ALLOWED_ORIGINS=https://catchhole.com,https://www.catchhole.com,https://catch-hole.vercel.app
# Gmail sender selected for initial signup email delivery.
# Set the Google app password and independent hash secret on the server before EMAIL rollout.
SIGNUP_VERIFICATION_METHOD=EMAIL
EMAIL_PROVIDER=smtp
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=aicatchhole@gmail.com
EMAIL_SMTP_PASSWORD=replace-with-smtp-app-password
EMAIL_FROM=aicatchhole@gmail.com
EMAIL_VERIFICATION_HASH_SECRET=replace-with-independent-at-least-32-byte-random-secret
EMAIL_VERIFICATION_EMAIL_HOURLY_LIMIT=5
EMAIL_VERIFICATION_EMAIL_DAILY_LIMIT=10
EMAIL_VERIFICATION_IP_HOURLY_LIMIT=10
EMAIL_VERIFICATION_IP_DAILY_LIMIT=20
EMAIL_VERIFICATION_GLOBAL_DAILY_LIMIT=100
EMAIL_VERIFICATION_GLOBAL_MONTHLY_LIMIT=3000

# Retained for SIGNUP_VERIFICATION_METHOD=PHONE. Not required in EMAIL mode.
SMS_PROVIDER=solapi
SOLAPI_API_KEY=replace-with-solapi-api-key
SOLAPI_API_SECRET=replace-with-solapi-api-secret
SOLAPI_SENDER_NUMBER=replace-with-registered-sender-number
PHONE_VERIFICATION_HASH_SECRET=replace-with-at-least-32-byte-random-secret
AI_TOKEN_DEFAULT_GRANT=2000000
AI_TOKEN_CONTACT_EMAIL=aicatchhole@gmail.com
AI_TOKEN_MINIMUM_ANALYSIS_RESERVATION=6256
AI_TOKEN_MINIMUM_COMPARISON_RESERVATION=128256

# Chat execution: keep disabled until the real handler (#238) is deployed and verified.
# Either gate requires a separate secret of at least 32 characters (do not reuse
# INTERNAL_API_KEY). Only public chat requires the private FastAPI URL.
# Enable operations independently for service-paid backfill before public rollout.
CHAT_ENABLED=false
CHAT_OPERATIONS_ENABLED=false
CHAT_PYTHON_URL=
CHAT_CAPABILITY_SECRET=
CHAT_MAX_BODY_BYTES=131072
CHAT_DISPATCH_THREADS=2
CHAT_DISPATCH_QUEUE_CAPACITY=32
CHAT_MAX_QUESTION_CHARACTERS=4000
CHAT_MAX_ACTIVE_PER_MEMBER=3
CHAT_MAX_CALLS=8
CHAT_MAX_TOOL_CALLS=20
# Cumulative per-attempt reservations: six text calls plus one query embedding.
# Account quota and measured usage settlement remain separate.
CHAT_ATTEMPT_TOKEN_BUDGET=240000
CHAT_EXECUTION_TIMEOUT=120s
CHAT_USAGE_GRACE=10m
CHAT_RECOVERY_DELAY_MS=5000

# Redis runs only on the API EC2 Docker network.
REDIS_PASSWORD=replace-with-strong-redis-password

# External Amazon RDS for PostgreSQL
DATABASE_URL=jdbc:postgresql://replace-with-rds-endpoint:5432/catchhole?sslmode=require
DATABASE_USERNAME=catchhole_admin
DATABASE_PASSWORD=replace-with-strong-rds-password
DATABASE_POOL_MAXIMUM_SIZE=10
DATABASE_POOL_MINIMUM_IDLE=2

# AWS and Amazon S3
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=catchhole-dev-037077640960-ap-northeast-2-an
AWS_S3_ENDPOINT_OVERRIDE=
# 회차 분석/비교 실패 알림. 실제 웹훅 URL은 서버 api.env에만 보관한다.
# migration 이후 실패는 비활성 중에도 DB에 대기하며 활성화 시 발송한다.
ANALYSIS_FAILURE_NOTIFICATIONS_ENABLED=false
ANALYSIS_FAILURE_DISCORD_WEBHOOK_URL=

# GH-332: 배포 후 고정된 선정 계정의 관계만 별도 Worker에서 순차 백필한다.
# false는 신규 관계 작업 접수를 멈춘다. 이미 실행 중인 호출의 즉시 취소는 아니다.
RELATIONSHIP_BACKFILL_ENABLED=true
RELATIONSHIP_BACKFILL_SCHEDULING_ENABLED=true
RELATIONSHIP_BACKFILL_FIXED_DELAY_MS=10000
# 회차 관계 작업당 누적 raw 예약 상한. 캠페인 전체 예산이 아니다.
RELATIONSHIP_BACKFILL_MAX_RESERVED_TOKENS_PER_JOB=2000000
