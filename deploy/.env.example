# Image tags
BACKEND_IMAGE=ghcr.io/catchhole-soma/catchhole-backend-java:main
AI_IMAGE=ghcr.io/catchhole-soma/catchhole-backend-ai:main

# Public API domain
API_DOMAIN=api.catchhole.com

# Shared runtime timezone
APP_TIMEZONE=Asia/Seoul

# Spring backend
BACKEND_JAVA_OPTS=-Xms256m -Xmx768m
JWT_SECRET=replace-with-at-least-32-byte-secret
INTERNAL_API_KEY=replace-with-internal-api-key
CORS_ALLOWED_ORIGINS=https://catchhole.com,https://www.catchhole.com,https://catch-hole.vercel.app
SMS_PROVIDER=solapi
SOLAPI_API_KEY=replace-with-solapi-api-key
SOLAPI_API_SECRET=replace-with-solapi-api-secret
SOLAPI_SENDER_NUMBER=replace-with-registered-sender-number
PHONE_VERIFICATION_HASH_SECRET=replace-with-at-least-32-byte-random-secret
AI_TOKEN_DEFAULT_GRANT=2000000
AI_TOKEN_CONTACT_EMAIL=aicatchhole@gmail.com
AI_TOKEN_MINIMUM_ANALYSIS_RESERVATION=6256
AI_TOKEN_MINIMUM_COMPARISON_RESERVATION=3256

# Redis (internal-only; no host port is published)
REDIS_PASSWORD=replace-with-strong-redis-password

# PostgreSQL
POSTGRES_DB=catchhole
POSTGRES_USER=catchhole
POSTGRES_PASSWORD=replace-with-strong-postgres-password

# AWS/S3
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=catchhole-dev-037077640960-ap-northeast-2-an
AWS_S3_ENDPOINT_OVERRIDE=
AWS_SQS_QUEUE_URL=

# LLM
LLM_API_KEY=replace-with-llm-api-key
LLM_MODEL=gpt-5.6-terra
LLM_EXTRACTION_MODEL=gpt-5.6-terra
LLM_SUBJECT_RESOLUTION_MODEL=gpt-5.6-luna
LLM_COMPARISON_MODEL=gpt-5.6-luna
LLM_REASONING_EFFORT=none
LLM_SETTING_EXTRACTION_MAX_OUTPUT_TOKENS=6000
LLM_SETTING_EXTRACTION_RETRY_MAX_OUTPUT_TOKENS=12000
LLM_WORLD_SETTING_EXTRACTION_MAX_OUTPUT_TOKENS=5000
LLM_WORLD_SETTING_EXTRACTION_RETRY_MAX_OUTPUT_TOKENS=10000
LLM_SUBJECT_RESOLUTION_MAX_OUTPUT_TOKENS=2000
LLM_COMPARISON_MAX_OUTPUT_TOKENS=3000
LLM_PROVIDER_MAX_OUTPUT_TOKENS=128000
OPENAI_RESPONSES_API_URL=https://api.openai.com/v1/responses
LLM_HTTP_MAX_RETRIES=3
LLM_HTTP_RETRY_BASE_SECONDS=2
EMBEDDING_GENERATION_ENABLED=false

# SETTING_EXTRACTION Worker rollout (2 processes x 5 jobs = 10 concurrent jobs)
AI_WORKER_PROCESS_COUNT=2
AI_WORKER_CONCURRENCY=5
LLM_MAX_CONCURRENT_REQUESTS=5
AI_WORKER_BLOCKING_MAX_WORKERS=3
AI_WORKER_IDLE_SLEEP_SECONDS=5
AI_WORKER_SHUTDOWN_GRACE_SECONDS=180
